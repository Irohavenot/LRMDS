# DepEd LRMDS – Environment Configuration
# -------------------------------------------------------
# INSTRUCTIONS:
#   1. Copy this file:  copy .env.example .env   (Windows)
#                      cp .env.example .env      (macOS/Linux)
#   2. Fill in your own values below
#   3. NEVER commit .env to Git — it is in .gitignore
# -------------------------------------------------------

# ── Database (MySQL via XAMPP) ───────────────────────────
DB_HOST=localhost
DB_NAME=lrmds
DB_USER=root
DB_PASS=

# ── App ──────────────────────────────────────────────────
# Must match your folder under htdocs (no trailing slash)
APP_BASE_URL=http://localhost/deped-lrmds-portal

# ── Google OAuth (Sign in with Google) ───────────────────
# https://console.cloud.google.com → APIs & Services → Credentials
# Application type: Web application
# Authorized redirect URI (adjust host/path if needed):
#   http://localhost/deped-lrmds-portal/auth/google_callback.php
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Mail (SMTP – PHPMailer) ──────────────────────────────
# Development: Mailtrap Email Testing (sandbox.smtp.mailtrap.io)
# Production:  Brevo, Gmail SMTP, or your org mail relay
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM_ADDR=noreply@lrmds.deped.gov.ph
MAIL_FROM_NAME=DepEd LRMDS

# ── Email verification ───────────────────────────────────
VERIFY_TOKEN_TTL_HOURS=24

# ── Microsoft / OneDrive (Azure app registration) ────────
# Azure Portal → App registrations → your app
# Use client-credentials flow; grant Microsoft Graph application permissions
# (e.g. Files.ReadWrite.All) with admin consent.
AZURE_CLIENT_ID=your_azure_application_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret_value
AZURE_TENANT_ID=your_azure_directory_tenant_id
ONEDRIVE_FOLDER_PATH=Documents/deped
# UPN of the Microsoft 365 user whose OneDrive receives uploads
ONEDRIVE_USER_UPN=your-service-account@yourtenant.onmicrosoft.com
