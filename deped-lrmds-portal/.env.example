# DepEd LRMDS – Environment Configuration
# -------------------------------------------------------
# INSTRUCTIONS FOR TEAMMATES:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your own values below
#   3. NEVER commit .env to Git — it is already in .gitignore
# -------------------------------------------------------

# ── Database ─────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=lrmds
DB_USER=root
DB_PASS=

# ── App ──────────────────────────────────────────────────
# Match whatever folder your project lives in under htdocs
APP_BASE_URL=http://localhost/LRMDS/deped-lrmds-portal

# ── Google OAuth ─────────────────────────────────────────
# Get from: console.cloud.google.com → your project → Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Mail (SMTP via Mailtrap Email Testing) ───────────────
# Get from: mailtrap.io → Email Testing → Inboxes
#           → My Inbox → SMTP Settings → select PHPMailer
# NOTE: Use Email TESTING (left sidebar), NOT Email Sending.
# No domain verification needed for testing.
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM_ADDR=noreply@lrmds.deped.gov.ph
MAIL_FROM_NAME=DepEd LRMDS

# ── Email verification ────────────────────────────────────
VERIFY_TOKEN_TTL_HOURS=24